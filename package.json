{
  "name": "career-cert",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "tauri build",
    "app:sandbox": "tauri dev --config src-tauri/tauri.sandbox.conf.json",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "test": "npm run test:scripts && npm run test:rust",
    "check:privacy": "node scripts/check-privacy.mjs",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.7",
    "@tauri-apps/api": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
