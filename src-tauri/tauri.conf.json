{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "방과후 강사 경력증명서",
  "mainBinaryName": "career-cert",
  "version": "0.0.1",
  "identifier": "kr.school.careercert",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1450",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "방과후 강사 경력증명서",
        "width": 1360,
        "height": 860,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Korean"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    },
    "publisher": "lohemal",
    "copyright": "Copyright © 2026 lohemal",
    "shortDescription": "방과후 강사 경력관리 및 경력증명서 발급",
    "category": "Education"
  }
}
