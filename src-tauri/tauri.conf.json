{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "방과후 강사 경력증명서",
  "mainBinaryName": "career-cert",
  "version": "0.1.1",
  "identifier": "kr.school.careercert",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1450",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "방과후 강사 경력증명서",
        "width": 1360,
        "height": 860,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; frame-src blob:; object-src blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Korean"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "publisher": "lohemal",
    "copyright": "Copyright © 2026 lohemal",
    "shortDescription": "방과후 강사 경력관리 및 경력증명서 발급",
    "category": "Education",
    "createUpdaterArtifacts": true,
    "homepage": "https://github.com/lohemal/careercert",
    "longDescription": "방과후학교 외부강사의 경력을 관리하고 경력증명서(활동 확인서)를 발급합니다. 주민등록번호·주소는 발급할 때만 입력해 암호화해 저장하며, 자료는 이 컴퓨터에만 저장됩니다."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/lohemal/careercert/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxODQ5NDQ5QkQ2RjBGQkQKUldTOUQyKzlTWlNFd1o4dXE3Z0FqenliR1VlMVQvWWhOMVlZb1ZIWTkxanRsK2QxS1NJVzVHOEoK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
